{
  "schema": "polis.tasks/1",
  "description": "Synthetic coding-agent evidence fixtures. Expected evidence is evaluator-only; heldout cases are separate from development cases. These are not real-user answer-quality scores.",
  "tasks": [
    {"id":"dev-database","split":"development","category":"decision","question":"Which database did the project choose?","items":[{"body":"The project chose SQLite as its database.","role":"user","session":"design","ts":1000}],"expected":["SQLite"]},
    {"id":"dev-exact-flag","split":"development","category":"identifier","question":"What did we decide about --frozen?","items":[{"body":"Use cargo build --frozen for the release pipeline.","role":"user","session":"release","ts":1000}],"expected":["--frozen"]},
    {"id":"dev-correction","split":"development","category":"source-time","question":"Which port is the API using?","filter":{"after":1500},"items":[{"body":"The API port is 8080.","role":"user","session":"old","ts":1000},{"body":"Correction: the API port is 9090.","role":"user","session":"new","ts":2000}],"expected":["9090"],"forbidden":["8080"]},
    {"id":"dev-assistant-neighbor","split":"development","category":"assistant","question":"What port did the assistant suggest for the standalone daemon?","items":[{"body":"What port should the standalone daemon use?","role":"user","session":"setup","ts":1000},{"body":"Use 7677 by default; 7676 is taken by the host app.","role":"assistant","session":"setup","ts":1000}],"expected":["7677"]},
    {"id":"held-indent","split":"heldout","category":"preference","question":"What is the indentation preference?","items":[{"body":"My indentation preference is tabs, with a display width of four.","role":"user","session":"editor","ts":1000}],"expected":["tabs","four"]},
    {"id":"held-two-sessions","split":"heldout","category":"multi-session","question":"What are Bluebird's deployment region and production database?","items":[{"body":"Bluebird deployment region is eu-west-2.","role":"user","session":"infra","ts":1000},{"body":"Bluebird production database is PostgreSQL.","role":"user","session":"storage","ts":2000}],"expected":["eu-west-2","PostgreSQL"]},
    {"id":"held-source-role","split":"heldout","category":"role-attribution","question":"Which language is selected?","filter":{"roles":["user"]},"items":[{"body":"The selected language is Rust.","role":"user","session":"planning","ts":1000},{"body":"I guess the selected language is Go.","role":"assistant","session":"planning","ts":2000}],"expected":["Rust"],"forbidden":["language is Go"]},
    {"id":"held-historical-config","split":"heldout","category":"source-time","question":"What is the cache configuration?","filter":{"before":1500},"items":[{"body":"The cache configuration uses a 60 second TTL.","role":"user","session":"initial","ts":1000},{"body":"The cache configuration now uses a 300 second TTL.","role":"user","session":"revision","ts":2000}],"expected":["60 second"],"forbidden":["300 second"]}
  ]
}
